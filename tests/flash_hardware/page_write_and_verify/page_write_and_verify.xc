#include <xs1.h>
#include <platform.h>
#include <print.h>
#include <quadflash.h>

#define _Bool int
#include <stdbool.h>

#define DEBUG_UNIT TEST
#define DEBUG_PRINT_ENABLE_TEST 0
#include "debug_print.h"

#define XASSERT_ENABLE_DEBUG 1
#define XASSERT_ENABLE_LINE_NUMBERS 1
#include "xassert.h"

#include "quadflash_extra.h"
#include "dfu_flash.h"

fl_QSPIPorts ports = {
  PORT_SQI_CS, PORT_SQI_SCLK, PORT_SQI_SIO, XS1_CLKBLK_1
};

fl_QuadDeviceSpec spec = { // IS25LQ016B
  0, 256, 8192, 3, 8, 0x9F, 0, 3, 0x9D4015, 0x20, 4096, 0x06, 0x04,
  PROT_TYPE_NONE, {{0,0},{0x00,0x00}}, 0x02, 0xEB, 1,
  SECTOR_LAYOUT_REGULAR, {4096,{0,{0}}}, 0x05, 0x01, 0x01
};

int main(void)
{
  int ret;
  unsigned address = -1;
  int timeout;
  bool erased;
  int start, end;
  timer tmr;

  ret = fl_connectToOneDevice(ports, spec);
  assert(ret == 0);

  ret = flash_locate_boot_upgrade_slot(address);
  assert(ret == 0);

  erased = flash_is_sector_erased(address);
  if (!erased) {
    ret = flash_erase_sector_async(address);
    assert(ret == 0);
    timeout = 1000;
    while (flash_is_busy() && timeout > 0) {
      delay_milliseconds(1);
      timeout--;
    }
    assert(timeout > 0);
  }

  char page[256] = {
    0xD9, 0x16, 0xAA, 0x31, 0x0B, 0xA4, 0x29, 0xDC, 0x2D, 0x9F, 0xF3, 0xC9, 0x05, 0x17, 0x0F, 0x3A,
    0xF5, 0xE2, 0x78, 0x97, 0xF0, 0xF8, 0x95, 0x8A, 0x70, 0x15, 0x03, 0xB2, 0xC3, 0xD0, 0x06, 0x43,
    0xB3, 0xDC, 0xAB, 0xCC, 0x85, 0xA7, 0x2D, 0x3B, 0x1E, 0x99, 0x03, 0xC9, 0xDD, 0xF3, 0x54, 0xCC,
    0x21, 0xB6, 0x04, 0x58, 0xF8, 0x0E, 0xD4, 0xE8, 0x54, 0x34, 0xC9, 0xFA, 0xEF, 0xC2, 0x9C, 0x15,
    0x13, 0x77, 0x7F, 0x67, 0xB4, 0xC4, 0x9B, 0x60, 0x32, 0x84, 0x18, 0x40, 0xC0, 0x05, 0x3B, 0x3B,
    0xB5, 0x0F, 0xDE, 0xA1, 0x11, 0x3D, 0x82, 0x18, 0x49, 0x10, 0x3B, 0x32, 0x2A, 0x6F, 0x2A, 0xCB,
    0xAE, 0x48, 0xEA, 0x20, 0x6B, 0xC2, 0xB0, 0xB2, 0xD4, 0xF1, 0x34, 0xDE, 0x2E, 0x93, 0xEF, 0xAD,
    0x13, 0x42, 0x70, 0xA8, 0xA1, 0xDE, 0xBA, 0x8D, 0x81, 0x8E, 0x9A, 0x3E, 0xA5, 0xAB, 0xFA, 0x76,
    0x3E, 0x3C, 0x2D, 0x13, 0x24, 0x3D, 0x54, 0xEC, 0x6A, 0xCF, 0xA3, 0xD0, 0x62, 0x35, 0x0F, 0x86,
    0x0E, 0x98, 0x07, 0x36, 0xC3, 0xB9, 0x0B, 0xEA, 0x4A, 0x62, 0x71, 0x02, 0x9F, 0x0B, 0x5A, 0x89,
    0x64, 0x05, 0xBF, 0xB4, 0x9B, 0x8F, 0x36, 0xE5, 0xEC, 0x3C, 0xC6, 0x1D, 0x9B, 0x2F, 0x8D, 0x59,
    0xCC, 0x2D, 0x00, 0x72, 0xAE, 0x25, 0x2A, 0xFF, 0x05, 0xE5, 0x45, 0x88, 0x34, 0x86, 0xEE, 0x17,
    0x06, 0x3E, 0x76, 0xB8, 0x20, 0x8F, 0x31, 0xE0, 0xF1, 0x06, 0xE6, 0x18, 0x40, 0xE3, 0x07, 0x46,
    0xE5, 0xA8, 0x96, 0x6B, 0x47, 0xAE, 0x8E, 0x4D, 0x49, 0xAC, 0x47, 0xCE, 0xAA, 0xC0, 0x1E, 0xCF,
    0x36, 0x0F, 0xE1, 0x74, 0x2E, 0x0F, 0x23, 0xB9, 0x6F, 0x9E, 0xC1, 0xA8, 0x31, 0x49, 0xEE, 0x58,
    0x4D, 0x89, 0x70, 0x72, 0x06, 0x69, 0x95, 0x4F, 0xEC, 0x7E, 0xF2, 0xF1, 0xCA, 0x8E, 0xDB, 0x54,
  };

  ret = flash_write_page_async(address, page);
  assert(ret == 0);
  tmr :> start;

  timeout = 1000;
  while (flash_is_busy() && timeout > 0) {
    delay_milliseconds(1);
    timeout--;
  }

  tmr :> end;
  assert(timeout > 0);
  debug_printf("write duration %d usec\n", (end - start) / 100);

  erased = flash_is_sector_erased(address);
  assert(!erased);

  ret = flash_verify_page(address, page) ? 0 : 1;
  assert(ret == 0);

  page[255] = 0;
  ret = flash_verify_page(address, page) ? 0 : 1;
  assert(ret != 0);

  ret = fl_disconnect();
  assert(ret == 0);

  printstr("PASS\n");
  return 0;
}
